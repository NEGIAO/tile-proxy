# tile-proxy 环境示例：复制为 .env 或写入 systemd Environment=
HOST=127.0.0.1
PORT=9002
LOG_LEVEL=INFO

# --- 内存瓦片缓存（条目数；单条约 10–50KB）---
# 公网/小内存 VPS 务必压低，默认 100000 会吃爆 1GB 机器
PROXY_TILE_CACHE_TTL_SECONDS=180
PROXY_TILE_CACHE_MAX_SIZE=3000

# 每 IP 每分钟请求数；0=不限（默认）。公网建议显式设为 120–300
PROXY_RATE_LIMIT=0

# 出站 HTTP
PROXY_HTTP_TIMEOUT_SECONDS=12
PROXY_HTTP_CONNECT_TIMEOUT_SECONDS=4
PROXY_MAX_CONNECTIONS=40
PROXY_MAX_KEEPALIVE_CONNECTIONS=10
PROXY_MAX_RESPONSE_MB=8

# SSRF：禁止代访内网（生产恒 false）
PROXY_ALLOW_PRIVATE_HOSTS=false
PROXY_DNS_GUARD=true

# --- 纠偏护栏 ---
GCJRE_MAX_CONCURRENCY=4
GCJRE_MAX_TILES_PER_REQUEST=16
GCJRE_TILE_MAX_MB=4
GCJRE_MAX_IMAGE_PIXELS=4194304

# 磁盘缓存目录与清理
GCJRE_CACHE=/var/cache/tile-proxy
GCJRE_CACHE_MAX_AGE_DAYS=3
GCJRE_CACHE_MAX_MB=512
GCJRE_CACHE_CLEANUP_INTERVAL_S=1800

# --- 瓦片有效性（防"永久白斑"）---
# 单源片取失败重试次数；用尽即抛错 → 5xx，不进任何一层缓存
GCJRE_FETCH_ATTEMPTS=3
# 空白源片缓存视为"软命中"的时限（秒）；超时后重新向上游取
GCJRE_BLANK_RETRY_SECONDS=600
# 输出透明像素占比上限（%），超过即判废并强制重取一次
GCJRE_MAX_TRANSPARENT_PERCENT=10

# --- 响应缓存（Cache-Control，覆盖上游原值）---
# 浏览器 TTL；不宜过长——坏瓦片 purge 清得掉边缘、清不掉浏览器
TILE_BROWSER_TTL_SECONDS=86400
# s-maxage（CDN 边缘 TTL），与 CF Cache Rule 对齐
TILE_EDGE_TTL_SECONDS=604800

# --- 来源校验（默认关闭，防护交给限流）---
# TILE_PROXY_ENFORCE_ORIGIN=1
# TILE_PROXY_ALLOWED_ORIGINS=https://webgis.negiao.cn,http://localhost:5173
